# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific extensions
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.proto text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
