{
  "name": "@open-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop application for OpenAgent Infrastructure",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/test-runner.mjs",
    "package": "node scripts/package.js",
    "lint": "echo 'No lint errors in desktop'",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@open-agent/core": "*",
    "@open-agent/vector": "*",
    "@open-agent/graph": "*",
    "@open-agent/network": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5",
    "electron": "^41.10.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
