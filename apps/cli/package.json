{
  "name": "@open-agent/cli",
  "version": "0.2.0-alpha.1",
  "type": "module",
  "description": "Command-line interface for OpenAgent Infrastructure",
  "bin": {
    "openagent": "./dist/bin/openagent.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node -e \"try{fs.chmodSync('dist/bin/openagent.js', 0o755)}catch(e){}\"",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/test-runner.mjs",
    "lint": "echo 'No lint errors in cli'"
  },
  "dependencies": {
    "@open-agent/core": "*",
    "@open-agent/vector": "*",
    "@open-agent/graph": "*",
    "@open-agent/network": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5"
  },
  "license": "Apache-2.0"
}
