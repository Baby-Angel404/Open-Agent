{
  "name": "@open-agent/vector",
  "version": "0.2.0-alpha.1",
  "description": "Lightweight local hybrid vector engine (dense vector + sparse BM25) for OpenAgent Infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node ../../scripts/test-runner.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint errors in vector'",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
